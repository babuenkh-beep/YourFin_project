# Copy this file to .env.local and fill in the values from your Supabase project's Connect dialog.
# These are public browser values. Never put a database password or service_role key in this file.
VITE_SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Local development uses Vite's /api proxy, so this can remain unset.
# In Vercel, set this to the deployed FastAPI endpoint including its /api path.
# Example: https://yourfin-api.example.com/api
VITE_API_BASE_URL=<YOUR_BACKEND_API_URL>